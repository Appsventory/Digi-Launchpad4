<?xml version="1.0" encoding="utf-8"?>
<!-- Focus/hover for settings rows (Clear cache style) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/setting_card_state_focused"/>
            <corners android:radius="@dimen/setting_card_radius"/>
            <stroke android:width="1.5dp" android:color="@color/setting_card_state_focused_stroke"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/setting_card_state_focused"/>
            <corners android:radius="@dimen/setting_card_radius"/>
            <stroke android:width="1dp" android:color="@color/setting_card_state_focused_stroke"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent"/>
            <corners android:radius="@dimen/setting_card_radius"/>
        </shape>
    </item>
</selector>
