<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/style_card_blur_hover" />
            <corners android:radius="@dimen/setting_card_radius" />
            <stroke android:width="1.5dp" android:color="@color/style_card_blur_stroke_hover" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/style_card_blur" />
            <corners android:radius="@dimen/setting_card_radius" />
            <stroke android:width="1dp" android:color="@color/style_card_blur_stroke" />
        </shape>
    </item>
</selector>
