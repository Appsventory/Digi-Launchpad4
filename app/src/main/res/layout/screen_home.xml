<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <FrameLayout
        android:id="@+id/homeContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <ScrollView
            android:id="@+id/homeScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/homeScrollInner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FF000000"
                android:layout_marginStart="-28dp"
                android:layout_marginEnd="-28dp"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingBottom="120dp">

                <!-- heroSection = 1 viewport (kosong di atas, konten di bawah).
                     Poster HANYA di heroContentBlock (ukuran = hero+favorite),
                     bukan full viewport — supaya bg tidak melebihi grup. -->
                <FrameLayout
                    android:id="@+id/heroSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-28dp"
                    android:layout_marginEnd="-28dp"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <!-- Scrim: bawah hitam 100%, ke atas semakin terang, atas tetap gelap -->
                    <View
                        android:id="@+id/heroSectionScrim"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/hero_section_scrim"
                        android:clickable="false"
                        android:focusable="false" />

                    <!-- Widget cuaca -->
                    <LinearLayout
                        android:id="@+id/homeWeatherWidget"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:layout_marginStart="28dp"
                        android:layout_marginTop="24dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="36dp"
                        android:paddingEnd="40dp"
                        android:paddingTop="30dp"
                        android:paddingBottom="30dp"
                        android:background="@drawable/bg_card_blur_dark"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="34dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/homeWeatherTemp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="#FFFFFFFF"
                                android:textSize="67sp"
                                android:textStyle="bold"
                                android:text="--°" />

                            <TextView
                                android:id="@+id/homeWeatherCondition"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:maxLines="1"
                                android:ellipsize="end"
                                android:textColor="#FFFFFFFF"
                                android:textSize="22sp"
                                android:text="…" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="18dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_marginEnd="6dp"
                                    android:src="@drawable/ic_location_pin"
                                    android:contentDescription="@null" />

                                <TextView
                                    android:id="@+id/homeWeatherLocationText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:maxLines="1"
                                    android:ellipsize="end"
                                    android:textColor="#CCFFFFFF"
                                    android:textSize="15sp"
                                    android:text="…" />

                            </LinearLayout>

                        </LinearLayout>

                        <TextView
                            android:id="@+id/homeWeatherEmoji"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            android:textSize="70sp"
                            android:text="⛅" />

                    </LinearLayout>

                    <!-- Blok konten nempel bawah -->
                    <FrameLayout
                        android:id="@+id/heroContentBlock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:clipChildren="false"
                        android:clipToPadding="false">

                        <!-- Poster via setBackground di heroContentBlock (code).
                             Background tidak mempengaruhi ukuran = tepat seluas
                             hero+favorite, tidak nembus. -->
                        <LinearLayout
                            android:id="@+id/heroGroup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:paddingStart="28dp"
                            android:paddingEnd="28dp"
                            android:paddingTop="24dp"
                            android:paddingBottom="16dp">

                            <LinearLayout
                                android:id="@+id/heroTextBlock"
                                android:layout_width="540dp"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <ImageView
                                    android:id="@+id/provider"
                                    android:layout_width="wrap_content"
                                    android:layout_height="20dp"
                                    android:scaleType="fitStart"
                                    android:contentDescription="@null" />

                                <TextView
                                    android:id="@+id/title"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:textColor="#FFFFFF"
                                    android:textSize="26sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/description"
                                    android:layout_width="540dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:maxLines="3"
                                    android:textColor="#E6FFFFFF"
                                    android:textSize="13sp"
                                    android:lineSpacingExtra="2dp" />

                                <TextView
                                    android:id="@+id/meta"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="5dp"
                                    android:paddingStart="2dp"
                                    android:paddingEnd="2dp"
                                    android:maxLines="1"
                                    android:ellipsize="end"
                                    android:textColor="#B3FFFFFF"
                                    android:textSize="11sp" />

                            </LinearLayout>

                            <TextView
                                android:id="@+id/topPicksTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="22dp"
                                android:text="Top picks for you"
                                android:textColor="#FFFFFF"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <HorizontalScrollView
                                android:id="@+id/recommendationScroll"
                                android:layout_width="match_parent"
                                android:layout_height="158dp"
                                android:layout_marginTop="8dp"
                                android:paddingStart="0dp"
                                android:paddingEnd="16dp"
                                android:paddingTop="10dp"
                                android:paddingBottom="10dp"
                                android:scrollbars="none"
                                android:overScrollMode="never"
                                android:clipChildren="false"
                                android:clipToPadding="false"
                                android:descendantFocusability="afterDescendants">

                                <LinearLayout
                                    android:id="@+id/recommendationContainer"
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:clipChildren="false"
                                    android:clipToPadding="false" />

                            </HorizontalScrollView>

                            <LinearLayout
                                android:id="@+id/favoriteGroup"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:clipChildren="false"
                                android:clipToPadding="false">

                                <TextView
                                    android:id="@+id/favoriteTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="14dp"
                                    android:text="@string/favorite_app"
                                    android:textColor="#FFFFFF"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />

                                <HorizontalScrollView
                                    android:id="@+id/appsScroll"
                                    android:layout_width="match_parent"
                                    android:layout_height="128dp"
                                    android:layout_marginTop="6dp"
                                    android:layout_marginBottom="4dp"
                                    android:paddingStart="0dp"
                                    android:paddingEnd="16dp"
                                    android:paddingTop="8dp"
                                    android:paddingBottom="8dp"
                                    android:scrollbars="none"
                                    android:overScrollMode="never"
                                    android:clipChildren="false"
                                    android:clipToPadding="false"
                                    android:descendantFocusability="afterDescendants">

                                    <LinearLayout
                                        android:id="@+id/appsContainer"
                                        android:layout_width="wrap_content"
                                        android:layout_height="match_parent"
                                        android:gravity="center_vertical"
                                        android:orientation="horizontal"
                                        android:clipChildren="false"
                                        android:clipToPadding="false" />

                                </HorizontalScrollView>

                            </LinearLayout>

                        </LinearLayout>

                    </FrameLayout>

                </FrameLayout>

                <LinearLayout
                    android:id="@+id/customChannelsSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#FF000000"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:visibility="gone" />

            </LinearLayout>

        </ScrollView>

    </FrameLayout>

</merge>
