<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/setting_card"
    android:paddingStart="28dp"
    android:paddingEnd="28dp"
    android:paddingTop="24dp"
    android:paddingBottom="20dp"
    android:clipToOutline="true">

    <!-- Title -->
    <TextView
        android:id="@+id/permTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="App Permissions"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        android:letterSpacing="0.01" />

    <!-- Subtitle / description -->
    <TextView
        android:id="@+id/permMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/white_70"
        android:textSize="14sp"
        android:lineSpacingExtra="3dp"
        android:text="Digi Home needs a few permissions to work fully." />

    <!-- Permission items container -->
    <LinearLayout
        android:id="@+id/permItemsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="vertical" />

    <!-- Buttons row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal"
        android:gravity="end">

        <TextView
            android:id="@+id/btnLater"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="100dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:gravity="center"
            android:text="Later"
            android:textColor="@color/white_70"
            android:textSize="15sp"
            android:background="@drawable/bg_hover_transparent"
            android:focusable="true"
            android:clickable="true"
            android:nextFocusRight="@id/btnAllow" />

        <TextView
            android:id="@+id/btnAllow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:minWidth="120dp"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:gravity="center"
            android:text="Allow"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/bg_hover_transparent"
            android:focusable="true"
            android:clickable="true"
            android:nextFocusLeft="@id/btnLater" />

    </LinearLayout>
</LinearLayout>