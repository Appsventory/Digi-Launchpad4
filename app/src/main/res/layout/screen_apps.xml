<?xml version="1.0" encoding="utf-8"?>
<!-- Apps: grid semua aplikasi terinstal. Logic-nya ui/apps/AppGridAdapter.kt. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

            <!-- Apps Grid -->
            <GridView
                android:id="@+id/appsGrid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="30dp"
                android:numColumns="@integer/apps_grid_num_columns"
                android:horizontalSpacing="@dimen/apps_grid_gap_h"
                android:verticalSpacing="@dimen/apps_grid_gap_v"
                android:stretchMode="columnWidth"
                android:gravity="center_horizontal"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingStart="@dimen/apps_grid_edge"
                android:paddingEnd="@dimen/apps_grid_edge"
                android:paddingTop="@dimen/apps_grid_edge"
                android:paddingBottom="@dimen/apps_grid_edge"
                android:listSelector="@android:color/transparent"
                android:focusable="true"
                android:descendantFocusability="afterDescendants"
                android:visibility="gone" />

</merge>
