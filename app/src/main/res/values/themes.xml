<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.DigiHome" parent="android:style/Theme.Material.NoActionBar">

        <item name="android:fontFamily">sans</item>

        <item name="android:windowFullscreen">true</item>

        <item name="android:windowActionModeOverlay">true</item>

        <item name="android:colorAccent">#FFFFFF</item>

        <item name="android:navigationBarColor">#08090D</item>

        <item name="android:windowLightStatusBar">false</item>

        <item name="android:windowNoTitle">true</item>

    </style>

    <!-- Judul section: minimalis, letter-spacing halus, warna soft -->
    <style name="SettingsSectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">#6B7280</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Tombol/baris aksi di dalam panel Pengaturan Launcher -->
    <style name="SettingsRowButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/settings_row_text_color</item>
        <item name="android:textSize">13sp</item>
        <item name="android:background">@drawable/bg_hover_solid</item>
        <item name="android:focusable">true</item>
    </style>

</resources>
