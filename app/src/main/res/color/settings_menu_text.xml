<?xml version="1.0" encoding="utf-8"?>
<!-- Text on menu rows: dark when focused (white pill), light otherwise -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="#FF0A0A0A"/>
    <item android:state_pressed="true" android:color="#FF0A0A0A"/>
    <item android:color="#FFFFFFFF"/>
</selector>
